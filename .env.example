# Canonical production origin, no trailing slash. Leave unset for local/preview builds.
NEXT_PUBLIC_SITE_URL=

# "true" ONLY on the production deployment. Anything else = noindex + robots Disallow.
SITE_INDEXABLE=

# Optional: Plausible (cookieless) analytics. Leave blank to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.outbound-links.js
# NEXT_PUBLIC_ANALYTICS_DEBUG=true

# Optional: adult newsletter form endpoint (POST with an `email` field, CORS-enabled).
# Leave blank to link to the author's existing newsletter instead.
NEXT_PUBLIC_NEWSLETTER_ACTION=

# Optional: redirects from the original series site once its domain points here.
LEGACY_REDIRECTS=
LEGACY_HOST=

# Optional Search Console / Bing ownership verification (tokens, not HTML tags).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
